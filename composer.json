{
    "name": "jhayao/lona-tenancy",
    "description": "Dedicated database workspaces for Filament v5.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bezhansalleh/filament-shield": "^4.0",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0|^13.0",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Liern\\FilamentTenancy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liern\\FilamentTenancy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Liern\\FilamentTenancy\\TenancyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    }
}
